#!/bin/bash
# Host CLI for soooski. Run with no arguments for the numbered menu.
#   curl -fsSL https://raw.githubusercontent.com/zwsq/soooski-panel/release/install.sh | sudo bash
set -euo pipefail

SOOOSKI_REPO="${SOOOSKI_REPO:-https://raw.githubusercontent.com/zwsq/soooski-panel}"
SOOOSKI_REF="${SOOOSKI_REF:-release}"
SOOOSKI_HOME="${SOOOSKI_HOME:-/opt/soooski}"
SOOOSKI_IMAGE="${SOOOSKI_IMAGE:-ghcr.io/zwsq/soooski-panel:${SOOOSKI_REF}}"
RAW="${SOOOSKI_REPO}/${SOOOSKI_REF}"

IN_MENU=0

die() { echo "soooski: $*" >&2; exit 1; }
info() { echo "soooski: $*"; }

# Avoid SIGPIPE under `set -o pipefail` (tr|head can exit 141).
rand_alnum() {
  local n="${1:-16}" s=""
  while [[ ${#s} -lt "$n" ]]; do
    s+=$(head -c 64 /dev/urandom | tr -dc 'A-Za-z0-9' || true)
  done
  printf '%s' "${s:0:$n}"
}

have_tty() { [[ -r /dev/tty && -w /dev/tty ]]; }

out() { printf '%s\n' "$*" >/dev/tty 2>/dev/null || printf '%s\n' "$*"; }

ask() {
  local var="$1" msg="$2" def="${3-}"
  local val=""
  if have_tty; then
    if [[ -n "$def" ]]; then
      printf '%s [%s]: ' "$msg" "$def" >/dev/tty
    else
      printf '%s: ' "$msg" >/dev/tty
    fi
    IFS= read -r val </dev/tty || true
  else
    val=""
  fi
  printf -v "$var" '%s' "${val:-$def}"
}

ask_secret() {
  local var="$1" msg="$2"
  local val=""
  if have_tty; then
    printf '%s: ' "$msg" >/dev/tty
    IFS= read -r -s val </dev/tty || true
    printf '\n' >/dev/tty
  fi
  printf -v "$var" '%s' "$val"
}

confirm() {
  local msg="${1:-Continue?}" def="${2:-N}" a=""
  if ! have_tty; then
    [[ "$def" == [Yy] ]]
    return
  fi
  printf '%s [%s]: ' "$msg" "$def" >/dev/tty
  IFS= read -r a </dev/tty || true
  a="${a:-$def}"
  [[ "$a" == [Yy] || "$a" == yes || "$a" == YES ]]
}

pause() {
  have_tty || return 0
  printf '\nPress Enter to return to the menu. ' >/dev/tty
  IFS= read -r _ </dev/tty || true
}

need_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    die "run as root (sudo soooski $*)"
  fi
}

installed() { [[ -f "$SOOOSKI_HOME/docker-compose.yml" ]]; }

env_get() {
  local key="$1"
  [[ -f "$SOOOSKI_HOME/.env" ]] || { echo ""; return 0; }
  local line
  line="$(grep -E "^${key}=" "$SOOOSKI_HOME/.env" | tail -n1 || true)"
  printf '%s' "${line#${key}=}"
}

docker_bin() {
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    echo docker
    return
  fi
  if command -v docker >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1; then
    echo "sudo docker"
    return
  fi
  if command -v docker >/dev/null 2>&1; then
    echo "sudo docker"
    return
  fi
  die "docker is not installed — choose Install from the menu (or: soooski install)"
}

compose() {
  local d
  d="$(docker_bin)"
  if $d compose version >/dev/null 2>&1; then
    $d compose --project-directory "$SOOOSKI_HOME" --env-file "$SOOOSKI_HOME/.env" -f "$SOOOSKI_HOME/docker-compose.yml" "$@"
    return
  fi
  if command -v docker-compose >/dev/null 2>&1; then
    (cd "$SOOOSKI_HOME" && docker-compose --env-file .env -f docker-compose.yml "$@")
    return
  fi
  die "docker compose is not available"
}

container_up() {
  local d
  d="$(docker_bin)" 2>/dev/null || return 1
  $d inspect -f '{{.State.Running}}' soooski 2>/dev/null | grep -qx true
}

ensure_linux() {
  [[ "$(uname -s)" == Linux ]] || die "this CLI is for a Linux VPS"
}

install_docker() {
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    return
  fi
  info "installing Docker"
  if ! command -v curl >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
      apt-get update -y
      apt-get install -y curl ca-certificates
    elif command -v yum >/dev/null 2>&1; then
      yum install -y curl ca-certificates
    else
      die "install curl, then rerun"
    fi
  fi
  curl -fsSL https://get.docker.com | sh
  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now docker >/dev/null 2>&1 || true
  fi
  command -v docker >/dev/null 2>&1 || die "docker install failed"
}

install_cli() {
  local tmp
  tmp="$(mktemp)"
  curl -fsSL "$RAW/scripts/soooski" -o "$tmp" || die "could not download CLI from $RAW/scripts/soooski"
  chmod 0755 "$tmp"
  mkdir -p /usr/local/bin
  mv "$tmp" /usr/local/bin/soooski
  info "CLI installed to /usr/local/bin/soooski"
}

fetch_compose() {
  mkdir -p "$SOOOSKI_HOME/data"
  curl -fsSL "$RAW/docker-compose.yml" -o "$SOOOSKI_HOME/docker-compose.yml" || die "could not download docker-compose.yml"
  curl -fsSL "$RAW/.env.example" -o "$SOOOSKI_HOME/.env.example" || true
}

write_env() {
  local host="$1" email="$2" user="$3" pass="$4"
  local log_level="${SOOOSKI_LOG_LEVEL:-}"
  [[ -n "$log_level" ]] || log_level="$(env_get SOOOSKI_LOG_LEVEL)"
  [[ -n "$log_level" ]] || log_level="info"
  umask 077
  cat >"$SOOOSKI_HOME/.env" <<EOF
SOOOSKI_PUBLIC_HOST=${host}
SOOOSKI_ACME_EMAIL=${email}
SOOOSKI_ADMIN_USER=${user}
SOOOSKI_ADMIN_PASSWORD=${pass}
SOOOSKI_IMAGE=${SOOOSKI_IMAGE}
SOOOSKI_DATA=./data
SOOOSKI_LOG_LEVEL=${log_level}
TZ=UTC
EOF
  chmod 600 "$SOOOSKI_HOME/.env"
}

wait_admin_url() {
  local i url=""
  for i in $(seq 1 40); do
    if [[ -s "$SOOOSKI_HOME/data/admin-url.txt" ]]; then
      tr -d '\n' <"$SOOOSKI_HOME/data/admin-url.txt"
      return 0
    fi
    sleep 1
  done
  echo ""
}

print_boot() {
  local url="$1" user="$2" pass="$3" generated="$4"
  echo
  echo "========================================"
  echo " soooski is up"
  echo " data:      $SOOOSKI_HOME/data"
  echo " admin:     ${url:-"(choose 7) Show admin URL later)"}"
  echo " user:      $user"
  if [[ "$generated" -eq 1 ]]; then
    echo " pass:      $pass"
    echo " (shown once — choose 9 if you lose it)"
  else
    echo " pass:      (the password you set)"
  fi
  echo " later:     sudo soooski     (numbered menu)"
  echo "========================================"
}

cmd_install() {
  ensure_linux
  need_root install
  local host="" email="" user="admin" pass="" skip_prompt=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="${2-}"; shift 2 ;;
      --email) email="${2-}"; shift 2 ;;
      --user) user="${2-}"; shift 2 ;;
      --password) pass="${2-}"; shift 2 ;;
      --image) SOOOSKI_IMAGE="${2-}"; shift 2 ;;
      --home) SOOOSKI_HOME="${2-}"; shift 2 ;;
      --yes|-y|--non-interactive) skip_prompt=1; shift ;;
      -h|--help)
        echo "soooski install [--host DOMAIN] [--email ADDR] [--user NAME] [--password PASS] [--yes]"
        return 0
        ;;
      *) die "unknown install flag $1" ;;
    esac
  done

  if installed && [[ "$skip_prompt" -eq 0 ]]; then
    info "panel files already exist at $SOOOSKI_HOME"
    if have_tty; then
      out "Use Update, Reconfigure, or Uninstall from the menu instead of installing again."
      confirm "Start / recreate the container with the current .env?" "Y" || return 0
      compose up -d
      info "started"
      return 0
    fi
  fi

  install_docker
  install_cli
  fetch_compose

  if [[ "$skip_prompt" -eq 0 ]]; then
    [[ -n "$host" ]] || ask host "Public host (domain for links + Let's Encrypt; empty = IP / self-signed)" "$(env_get SOOOSKI_PUBLIC_HOST)"
    [[ -n "$email" ]] || ask email "Let's Encrypt email (recommended)" "$(env_get SOOOSKI_ACME_EMAIL)"
    ask user "Admin username" "${user:-admin}"
    if [[ -z "$pass" ]]; then
      ask_secret pass "Admin password (empty = generate and print once)"
    fi
    echo
    echo "  home:  $SOOOSKI_HOME"
    echo "  image: $SOOOSKI_IMAGE"
    echo "  host:  ${host:-(none — self-signed)}"
    echo "  email: ${email:-(none)}"
    echo "  user:  $user"
    confirm "Install with these settings?" "Y" || return 0
  fi
  user="${user:-admin}"
  local generated=0
  if [[ -z "$pass" ]]; then
    pass="$(rand_alnum 16)"
    generated=1
  fi
  if [[ ${#pass} -lt 8 ]]; then
    die "password must be at least 8 characters"
  fi

  write_env "$host" "$email" "$user" "$pass"
  info "pulling ${SOOOSKI_IMAGE}"
  compose pull
  compose up -d
  local url
  url="$(wait_admin_url)"
  # first-boot env is consumed; do not leave the password in .env
  write_env "$host" "$email" "$user" ""
  print_boot "$url" "$user" "$pass" "$generated"
}

cmd_update() {
  need_root update
  [[ -f "$SOOOSKI_HOME/docker-compose.yml" ]] || die "not installed — choose 1) Install"
  install_cli
  fetch_compose
  compose pull
  compose up -d
  info "updated"
}

cmd_start() { [[ -f "$SOOOSKI_HOME/docker-compose.yml" ]] || die "not installed"; compose up -d; info "started"; }
cmd_stop() { compose down; info "stopped (data kept)"; }
cmd_restart() { compose restart; info "restarted"; }
cmd_logs() {
  if [[ $# -eq 0 ]]; then
    compose logs --tail 100
  else
    compose logs "$@"
  fi
}
cmd_status() { compose ps; }

cmd_url() {
  if [[ -s "$SOOOSKI_HOME/data/admin-url.txt" ]]; then
    tr -d '\n' <"$SOOOSKI_HOME/data/admin-url.txt"
    echo
    return
  fi
  die "admin URL not ready yet — try logs"
}

cmd_reset_admin() {
  local d user="" pass=""
  d="$(docker_bin)"
  $d inspect soooski >/dev/null 2>&1 || die "container is not running — choose Start first"
  if [[ $# -eq 0 ]] && have_tty; then
    ask user "New admin username (empty = keep current)" ""
    ask_secret pass "New password (empty = generate and print once)"
    if [[ -n "$pass" && ${#pass} -lt 8 ]]; then
      die "password must be at least 8 characters"
    fi
    confirm "Reset admin login and drop all sessions?" "Y" || return 0
    local args=()
    [[ -n "$user" ]] && args+=(-user "$user")
    [[ -n "$pass" ]] && args+=(-password "$pass")
    if [[ ${#args[@]} -gt 0 ]]; then
      $d exec soooski soooski reset-admin "${args[@]}"
    else
      $d exec soooski soooski reset-admin
    fi
    return
  fi
  $d exec soooski soooski reset-admin "$@"
}

cmd_reconfigure() {
  need_root reconfigure
  installed || die "not installed — choose 1) Install"
  local host email user img
  host="$(env_get SOOOSKI_PUBLIC_HOST)"
  email="$(env_get SOOOSKI_ACME_EMAIL)"
  user="$(env_get SOOOSKI_ADMIN_USER)"
  user="${user:-admin}"
  img="$(env_get SOOOSKI_IMAGE)"
  [[ -n "$img" ]] && SOOOSKI_IMAGE="$img"
  ask host "Public host" "$host"
  ask email "Let's Encrypt email" "$email"
  confirm "Write .env and restart?" "Y" || return 0
  write_env "$host" "$email" "$user" ""
  compose up -d
  info "reconfigured"
  cmd_url || true
}

cmd_uninstall() {
  need_root uninstall
  local purge=0
  if [[ "${1-}" == "--purge" ]]; then
    purge=1
  elif have_tty; then
    echo "  1) Stop the container, keep /opt/soooski/data"
    echo "  2) Stop and DELETE all data (cannot undo)"
    echo "  0) Cancel"
    local c=""
    ask c "Select" "0"
    case "$c" in
      1) purge=0 ;;
      2) purge=1 ;;
      *) info "cancelled"; return 0 ;;
    esac
    if [[ "$purge" -eq 1 ]]; then
      confirm "Really delete $SOOOSKI_HOME including SQLite and certs?" "N" || return 0
    fi
  fi
  if [[ -f "$SOOOSKI_HOME/docker-compose.yml" ]]; then
    compose down || true
  fi
  if [[ "$purge" -eq 1 ]]; then
    rm -rf "$SOOOSKI_HOME"
    info "removed $SOOOSKI_HOME"
  else
    info "container stopped; data kept in $SOOOSKI_HOME/data"
  fi
}

menu_logs() {
  echo
  echo "  1) Last 100 lines"
  echo "  2) Follow (Ctrl+C returns to the menu)"
  echo "  0) Back"
  local c=""
  ask c "Select" "1"
  case "$c" in
    2)
      trap ':' INT
      compose logs -f --tail 50 || true
      trap 'echo; exit 0' INT
      ;;
    0) return 0 ;;
    *) compose logs --tail 100 || true ;;
  esac
}

print_menu() {
  local st="not installed" url=""
  if installed; then
    if container_up; then
      st="running"
    else
      st="stopped"
    fi
    if [[ -s "$SOOOSKI_HOME/data/admin-url.txt" ]]; then
      url="$(tr -d '\n' <"$SOOOSKI_HOME/data/admin-url.txt")"
    fi
  fi
  echo
  echo "================================================"
  echo " soooski"
  echo " status: $st"
  [[ -n "$url" ]] && echo " admin:  $url"
  echo "================================================"
  echo "  1) Install panel"
  echo "  2) Update panel"
  echo "  3) Start"
  echo "  4) Stop"
  echo "  5) Restart"
  echo "  6) Status"
  echo "  7) Show admin URL"
  echo "  8) View logs"
  echo "  9) Reset admin username / password"
  echo " 10) Reconfigure domain / Let's Encrypt email"
  echo " 11) Uninstall"
  echo "  0) Exit"
  echo "================================================"
}

run_action() {
  # Subshell so `die` / set -e cannot kill the menu.
  if ( set -euo pipefail; "$@" ); then
    return 0
  fi
  echo "soooski: that action failed" >&2
  return 0
}

run_menu() {
  have_tty || die "no terminal — run from SSH, or pass a command (soooski help)"
  IN_MENU=1
  local choice=""
  while true; do
    trap 'echo; exit 0' INT
    print_menu
    ask choice "Enter a number" ""
    echo
    case "$choice" in
      1) run_action cmd_install ;;
      2) run_action cmd_update ;;
      3) run_action cmd_start ;;
      4) run_action cmd_stop ;;
      5) run_action cmd_restart ;;
      6) run_action cmd_status ;;
      7) run_action cmd_url ;;
      8) run_action menu_logs ;;
      9) run_action cmd_reset_admin ;;
      10) run_action cmd_reconfigure ;;
      11) run_action cmd_uninstall ;;
      0|q|Q|exit|quit) echo "bye"; break ;;
      "") continue ;;
      *) echo "soooski: unknown choice '$choice' — enter a number from the list" ;;
    esac
    case "$choice" in
      0|q|Q|exit|quit) break ;;
      "") ;;
      *) pause ;;
    esac
  done
}

usage() {
  cat <<'EOF'
soooski — install and operate the panel on a Linux VPS.

  sudo soooski            numbered menu (install, update, logs, reset-admin, …)
  soooski install         same install wizard as menu item 1
  soooski update          refresh CLI, compose file, and image
  soooski start|stop|restart
  soooski logs            container logs (-f to follow)
  soooski status          docker compose ps
  soooski url             print the secret admin URL
  soooski reset-admin     set admin user/password (forgot password)
  soooski reconfigure     change public host / ACME email
  soooski uninstall       stop the container [--purge also deletes data]
  soooski help            this text

install flags: --host --email --user --password --yes
reset-admin flags: -user -password  (empty password = generate)

Typical first run:
  curl -fsSL https://raw.githubusercontent.com/zwsq/soooski-panel/release/install.sh | sudo bash
  (opens this menu — choose 1)
EOF
}

main() {
  local cmd="${1-}"
  shift || true
  case "$cmd" in
    ""|menu) run_menu ;;
    -h|--help|help) usage ;;
    install) cmd_install "$@" ;;
    update) cmd_update "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    logs) cmd_logs "$@" ;;
    status|ps) cmd_status "$@" ;;
    url) cmd_url "$@" ;;
    reset-admin) cmd_reset_admin "$@" ;;
    reconfigure) cmd_reconfigure "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    *) die "unknown command $cmd (try: soooski help)" ;;
  esac
}

main "$@"
