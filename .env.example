# Copy to .env next to docker-compose.yml and edit.
#   cp .env.example .env

# Public hostname used in share links and Let's Encrypt (not an IP, not vpn.example.com).
SOOOSKI_PUBLIC_HOST=vpn.example.com

# Let's Encrypt contact. Recommended so they can warn you about expiry.
SOOOSKI_ACME_EMAIL=you@example.com

# First boot only. Change later in Settings, or: soooski reset-admin
SOOOSKI_ADMIN_USER=admin

# First boot only. Empty = random password printed once.
# Change afterwards in Settings, or: soooski reset-admin
SOOOSKI_ADMIN_PASSWORD=

# Image. After CI on release: ghcr.io/zwsq/soooski-panel:release
SOOOSKI_IMAGE=ghcr.io/zwsq/soooski-panel:release

# Host directory mounted at /data (SQLite, certs, sing-box.json). Keep this forever.
SOOOSKI_DATA=./data

TZ=UTC
